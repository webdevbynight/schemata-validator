{
  "name": "schemata-validator",
  "version": "0.3.2",
  "description": "Check the validity of Schema.org vocabulary used in JSON-LD and HTML microdata",
  "keywords": [
    "html",
    "html5",
    "json-ld",
    "microdata",
    "schema-org",
    "web-semantic",
    "validator"
  ],
  "homepage": "https://github.com/webdevbynight/schemata-validator",
  "bugs": {
    "url": "https://github.com/webdevbynight/schemata-validator/issues"
  },
  "author": "Victor Brito (https://victor-brito.dev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webdevbynight/schemata-validator.git"
  },
  "type": "module",
  "license": "MIT",
  "files": [
    "data",
    "dist"
  ],
  "exports": {
    "import": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "bin": {
    "schemata-validator": "./bin/cli.js"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0",
    "npm": ">=10.9.0",
    "pnpm": ">=11.1.3"
  },
  "scripts": {
    "biome": "biome check --write .",
    "biome:check": "biome check .",
    "biome:format": "biome format --write .",
    "biome:format:check": "biome format .",
    "biome:lint": "biome lint --write .",
    "biome:lint:check": "biome lint .",
    "build": "tsc",
    "dev": "pnpm tsc:watch & pnpm test:watch",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "tsc:watch": "tsc --watch --preserveWatchOutput"
  },
  "dependencies": {
    "parse5": "8.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@types/node": "24.13.0",
    "husky": "9.1.7",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
